{% extends 'base.html' %}
{% block content %}
<div class="card p-4">
    <h4 class="mb-3"><i class="fas fa-user-shield"></i> Admin Control Panel</h4>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Student</th>
                    <th>Category</th>
                    <th>Issue</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for c in complaints %}
                <tr>
                    <td>#{{ c.id }}</td>
                    <td>{{ c.student_name }}</td>
                    <td>{{ c.category }}</td>
                    <td>{{ c.description }}</td>
                    <td>
                        <span class="badge bg-{{ 'success' if c.status == 'Resolved' else 'warning' }}">
                            {{ c.status }}
                        </span>
                    </td>
                    <td>{{ c.faculty_name if c.faculty_name else 'Unassigned' }}</td>
                    <td>
                        {% if c.status != 'Resolved' %}
                        <form action="{{ url_for('assign_complaint') }}" method="POST" class="d-flex">
                            <input type="hidden" name="complaint_id" value="{{ c.id }}">
                            <select name="faculty_id" class="form-select form-select-sm me-2" required>
                                <option value="" selected disabled>Select Faculty</option>
                                {% for f in faculties %}
                                    <option value="{{ f.id }}">{{ f.name }} ({{ f.designation }})</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Assign</button>
                        </form>
                        {% else %}
                        <span class="text-success"><i class="fas fa-check-circle"></i> Closed</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
