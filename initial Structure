<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CVRU CMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; }
        .card { border: none; shadow: 0 4px 6px rgba(246, 6, 6, 0.92); border-radius: 10px; }
        .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .btn-primary { background-color: #667eea; border: none; }
        .btn-primary:hover { background-color: #5a6fd1; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fas fa-university me-2"></i>Dr CVRU Complaint Management System</a>
            {% if session.user_id %}
            <div class="d-flex">
                <span class="navbar-text text-white me-3">Welcome, {{ session.name }} ({{ session.role|title }})</span>
                <a href="{{ url_for('logout') }}" class="btn btn-outline-light btn-sm">Logout</a>
            </div>
            {% endif %}
        </div>
    </nav>

    <div class="container">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endif %}
        {% endwith %}
        
        {% block content %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Dynamic form handling for signup
        function toggleSignup() {
            const role = document.getElementById('roleSelect').value;
            const studentFields = document.getElementById('studentFields');
            const facultyFields = document.getElementById('facultyFields');
            
            if(role === 'student'){
                studentFields.style.display = 'block';
                facultyFields.style.display = 'none';
                // Toggle required attributes
                document.querySelectorAll('#studentFields input').forEach(i => i.required = true);
                document.querySelectorAll('#facultyFields input').forEach(i => i.required = false);
            } else {
                studentFields.style.display = 'none';
                facultyFields.style.display = 'block';
                document.querySelectorAll('#studentFields input').forEach(i => i.required = false);
                document.querySelectorAll('#facultyFields input').forEach(i => i.required = true);
            }
        }
    </script>
</body>
</html>
